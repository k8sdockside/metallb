{
    "$schema": "https://raw.githubusercontent.com/rogerwesterbo/k8sdockside/main/docs/plugin.schema.json",
    "id": "metallb",
    "name": "MetalLB",
    "version": "1.0.0",
    "minAppVersion": "0.0.15",
    "tagline": "load balancer addresses for bare-metal clusters",
    "icon": "gateway",
    "docs": "https://metallb.io/",
    "author": "Roger Westerbo",
    "links": [
        { "label": "metallb.io", "url": "https://metallb.io" },
        { "label": "Configuration", "url": "https://metallb.io/configuration/" },
        { "label": "GitHub", "url": "https://github.com/metallb/metallb" },
        { "label": "Plugin source", "url": "https://github.com/rogerwesterbo/k8sdockside-metallb" }
    ],
    "description": "MetalLB gives LoadBalancer services an address from a pool you own, and tells the network where that address lives — by answering ARP/NDP from one node (Layer 2), or by announcing it to your routers (BGP).\n\nStart with Address space: every pool as a map of its addresses, coloured by the namespace holding each one. Click any address to follow its route out of the cluster, or a free one to give it to a service. Services still waiting for an address are listed at the top with the reason and a fix. Announcements draws the path from pool to advertisement to node to router, and says what is wrong with it.\n\nEvery Service and every IPAddressPool also gets a MetalLB panel in its detail view. Changes are always shown to you before they are made.",
    "requires": [
        { "kind": "crd:ipaddresspools.metallb.io", "label": "IP address pools" },
        { "kind": "crd:l2advertisements.metallb.io", "label": "L2 advertisements" },
        { "kind": "crd:bgpadvertisements.metallb.io", "label": "BGP advertisements" },
        { "kind": "crd:bgppeers.metallb.io", "label": "BGP peers", "optional": true },
        { "kind": "crd:bfdprofiles.metallb.io", "label": "BFD profiles", "optional": true },
        { "kind": "crd:communities.metallb.io", "label": "Communities", "optional": true },
        { "kind": "crd:servicel2statuses.metallb.io", "label": "Layer 2 status (0.14+)", "optional": true },
        { "kind": "crd:servicebgpstatuses.metallb.io", "label": "BGP status", "optional": true }
    ],
    "ui": {
        "kinds": ["services", "nodes", "pods", "events"],
        "write": true
    },
    "overview": { "entry": "overview.html" },
    "views": [
        { "id": "space", "label": "Address space", "icon": "layers", "type": "custom", "entry": "index.html" },
        { "id": "routes", "label": "Announcements", "icon": "route", "type": "custom", "entry": "routes.html" },
        { "id": "pools", "label": "IP address pools", "icon": "database", "kind": "crd:ipaddresspools.metallb.io" },
        { "id": "l2", "label": "L2 advertisements", "icon": "link", "kind": "crd:l2advertisements.metallb.io" },
        { "id": "bgp", "label": "BGP advertisements", "icon": "share", "kind": "crd:bgpadvertisements.metallb.io" },
        { "id": "peers", "label": "BGP peers", "icon": "globe", "kind": "crd:bgppeers.metallb.io" },
        { "id": "bfd", "label": "BFD profiles", "icon": "gauge", "kind": "crd:bfdprofiles.metallb.io" },
        { "id": "communities", "label": "Communities", "icon": "type", "kind": "crd:communities.metallb.io" },
        { "id": "l2-status", "label": "Layer 2 status", "icon": "check", "kind": "crd:servicel2statuses.metallb.io" },
        { "id": "bgp-status", "label": "BGP status", "icon": "check", "kind": "crd:servicebgpstatuses.metallb.io" },
        {
            "id": "components",
            "label": "MetalLB's own pods",
            "icon": "server",
            "kind": "pods",
            "selector": "app.kubernetes.io/name=metallb"
        }
    ],
    "cards": [
        { "label": "IP address pools", "kind": "crd:ipaddresspools.metallb.io" },
        { "label": "L2 advertisements", "kind": "crd:l2advertisements.metallb.io" },
        { "label": "BGP advertisements", "kind": "crd:bgpadvertisements.metallb.io" },
        { "label": "BGP peers", "kind": "crd:bgppeers.metallb.io" },
        {
            "label": "MetalLB's own pods",
            "kind": "pods",
            "selector": "app.kubernetes.io/name=metallb",
            "groupBy": "status.phase",
            "tones": { "Running": "ok", "Pending": "warn", "Failed": "error", "Unknown": "warn" }
        }
    ],
    "charts": [
        {
            "id": "addresses-in-use",
            "label": "Addresses in use",
            "attach": "overview",
            "unit": "count",
            "legend": "pool",
            "description": "Addresses MetalLB's controller has handed out, per pool. Needs the controller's metrics scraped. Drawn by the plugin's own overview page.",
            "query": "sum by (pool) (metallb_allocator_addresses_in_use_total)"
        },
        {
            "id": "bgp-sessions",
            "label": "BGP sessions up",
            "attach": "overview",
            "unit": "count",
            "legend": "peer",
            "description": "Speakers with an established session to each peer. Empty on a Layer 2 only setup.",
            "query": "sum by (peer) (metallb_bgp_session_up)"
        },
        {
            "id": "pool-in-use",
            "label": "Addresses in use",
            "attach": "crd:ipaddresspools.metallb.io",
            "unit": "count",
            "legend": "pool",
            "description": "How many of this pool's addresses are handed out, over time.",
            "query": "sum by (pool) (metallb_allocator_addresses_in_use_total{pool=\"$name\"})"
        }
    ],
    "sections": [
        { "id": "service", "label": "MetalLB", "kind": "services", "entry": "service.html", "height": 150 },
        { "id": "pool", "label": "Addresses", "kind": "crd:ipaddresspools.metallb.io", "entry": "pool.html", "height": 360 }
    ]
}
